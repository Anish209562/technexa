# Public site origin, without a trailing slash. Enables absolute canonical links and sitemap generation.
VITE_SITE_URL=
# Real business inbox. Enables a user-reviewed email draft; does not send email automatically.
VITE_CONTACT_EMAIL=
# Optional Sentry DSN for browser error tracking.
VITE_SENTRY_DSN=
# Optional build-time base path for GitHub Pages, for example /tnsol.
BASE_PATH=
# Optional local verification target used by scripts/verify-*.mjs.
PREVIEW_URL=http://localhost:5174
